    <script type="module">
        // Global variables for cart functionality
        let cart = [];
        let orderCounter = 1;

        // Landing page functionality
        function updateLandingTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit',
                hour12: true
            });
            const landingTimeEl = document.getElementById('landingTime');
            if (landingTimeEl) {
                landingTimeEl.textContent = timeString;
            }
        }

        // Initialize landing page
        updateLandingTime();
        setInterval(updateLandingTime, 1000);

        function updateTime() {
            const now = new Date();
            const currentTimeEl = document.getElementById('currentTime');
            if (currentTimeEl) {
                currentTimeEl.textContent = now.toLocaleTimeString();
            }
        }

        // Cart Modal functionality
        function toggleCart() {
            const overlay = document.getElementById('cartModalOverlay');
            const modal = document.getElementById('cartModal');

            overlay.classList.toggle('active');
            modal.classList.toggle('active');

            if (modal.classList.contains('active')) {
                document.body.style.overflow = 'hidden';
                // updateCartModalDisplay();
            } else {
                document.body.style.overflow = 'auto';
            }
        }

        function closeCart() {
            const overlay = document.getElementById('cartModalOverlay');
            const modal = document.getElementById('cartModal');

            overlay.classList.remove('active');
            modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function updateCartBadge() {
            const cartBadge = document.getElementById('cartBadge');
            const navSubtotal = document.getElementById('navSubtotal');
            const itemCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            if (cartBadge) {
                cartBadge.textContent = itemCount;
            }

            if (navSubtotal) {
                if (subtotal > 0) {
                    navSubtotal.textContent = `${subtotal.toFixed(2)}`;
                    navSubtotal.style.display = 'block';
                } else {
                    navSubtotal.style.display = 'none';
                }
            }

            // Animate badge
            if (itemCount > 0 && cartBadge) {
                cartBadge.style.animation = 'none';
                setTimeout(() => {
                    cartBadge.style.animation = 'pulse 0.3s ease';
                }, 10);
            }
        }


        function closeModal() {
            const successModal = document.getElementById('successModal');
            if (successModal) {
                successModal.style.display = 'none';
            }
        }

        // Make functions globally available
        window.toggleCart = toggleCart;
        window.closeCart = closeCart;
        window.closeModal = closeModal;

        // Initialize
        document.addEventListener("DOMContentLoaded", () => {
            const savedLang = localStorage.getItem("selectedLang") || 'en';
            selectLanguage(savedLang);
            updateTime();
            setInterval(updateTime, 1000);
            updateCartBadge();
        });

        // Close cart when clicking outside or pressing Escape
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeCart();
            }
        });



    </script>
