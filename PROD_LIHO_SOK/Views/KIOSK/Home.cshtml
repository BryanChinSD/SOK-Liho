        @@keyframes lihoLionRun {
            0%   { transform: translateX(260px);  opacity: 0; }
            15%  { transform: translateX(160px);  opacity: 1; }
            45%  { transform: translateX(0);      opacity: 1; }
            50%  { transform: translateX(0) scale(1.06); }
            55%  { transform: translateX(0) scale(1); }
            85%  { transform: translateX(-160px); opacity: 1; }
            100% { transform: translateX(-260px); opacity: 0; }
        }
        @@keyframes lihoLionBounce {
            0%, 100% { transform: translateY(0px); }
            50%      { transform: translateY(-14px); }
        }
        @@keyframes lihoDotBounce {
            0%, 80%, 100% {
                transform: scale(0.6);
            }
            40% {
                transform: scale(1);
            }
        }
        #lihoLoaderInner {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .liho-track {
            width: 100%;
            max-width: 100vw;
            height: 200px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .liho-lion-wrap {
            animation: lihoLionRun 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
            display: flex;
            align-items: center;
            justify-content: center;
            width : 700px;
        }
        .liho-lion-img {
            width: 180px;
            height: 180px;
            max-width: 60vw;
            object-fit: contain;
            display: block;
            animation: lihoLionBounce 0.46s ease-in-out infinite;
