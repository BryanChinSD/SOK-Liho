        function showPromotionModal() {
             const modal = document.getElementById('promotionModalOverlay');
             if (!modal) return;

             modal.classList.add('active');
             document.body.style.overflow = 'hidden';

             // Optional: Start countdown timer if enabled
             startPromotionTimer();

             console.log('🎉 Promotion modal opened');
         }

         function closePromotionModal() {
             const modal = document.getElementById('promotionModalOverlay');
             if (!modal) return;

             modal.classList.remove('active');
             document.body.style.overflow = 'auto';



             console.log('✅ Promotion modal closed');
         }

         function proceedFromPromotion() {
             closePromotionModal();
             // Optionally trigger member login or any other action
             showLoginScreen();
         }

         // Optional: Countdown timer for limited offers
         function startPromotionTimer() {
             const timerElement = document.getElementById('promotionTimerValue');
             if (!timerElement) return;

             // Set end time (example: 2 hours from now)
             const endTime = new Date().getTime() + (2 * 60 * 60 * 1000);

             const updateTimer = () => {
                 const now = new Date().getTime();
                 const timeLeft = endTime - now;

                 if (timeLeft <= 0) {
                     timerElement.textContent = '00:00:00';
                     clearInterval(timerInterval);
                     return;
                 }

                 const hours = Math.floor(timeLeft / (1000 * 60 * 60));
                 const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                 const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                 timerElement.textContent =
                     `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
             };

             updateTimer();
             const timerInterval = setInterval(updateTimer, 1000);
         }

         // Auto-show promotion on page load
         function initPromotionModal() {

             // showPromotionModal();
         }

         // Export functions globally
         window.showPromotionModal = showPromotionModal;
         window.closePromotionModal = closePromotionModal;
         window.proceedFromPromotion = proceedFromPromotion;

         // Initialize on DOM ready
         document.addEventListener('DOMContentLoaded', () => {
             initPromotionModal();
         });
    </script>
