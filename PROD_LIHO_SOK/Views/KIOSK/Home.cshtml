    <script>


        (function() {
            const RESTAURANT_CONFIG = {
                color: '#D3281B',
                logo: "/img/liHO-SG-Logo.png",
                baseImageUrl: "/api/GetImageProxy?imageUrl="
            };

            const root = document.documentElement;
            root.style.setProperty('--primary', RESTAURANT_CONFIG.color);
            root.style.setProperty('--primary-hover', adjustColor(RESTAURANT_CONFIG.color, -10));
            root.style.setProperty('--primary-light', adjustColor(RESTAURANT_CONFIG.color, 40));

            function applyLogo() {
                ['langing-kiosk-logo', 'kiosk-logo'].forEach(id => {
                    const img = document.getElementById(id);
                    if (img) {
                        img.src = RESTAURANT_CONFIG.logo;
                        img.alt = 'Kiosk Logo';
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', applyLogo);
            } else {
                applyLogo();
            }

            function adjustColor(hex, percent) {
                const num = parseInt(hex.replace('#', ''), 16);
                const amt = Math.round(2.55 * percent);
                const R = Math.min(255, Math.max(0, (num >> 16) + amt));
                const G = Math.min(255, Math.max(0, (num >> 8 & 0x00FF) + amt));
                const B = Math.min(255, Math.max(0, (num & 0x0000FF) + amt));
                return `#${(0x1000000 + (R << 16) + (G << 8) + B).toString(16).slice(1)}`;
            }

             const preloadStrategies = {
                // Strategy 1: Image object preload
                imagePreload: () => {
                    const preloadImg = new Image();
                    preloadImg.onload = () => {
                        console.log('✅ Logo preloaded via Image object');
                        sessionStorage.setItem('logo-preloaded', 'true');
                    };
                    preloadImg.onerror = () => console.error('❌ Logo preload failed');
                    preloadImg.src = RESTAURANT_CONFIG.logo;
                },

                // Strategy 2: Fetch API preload with cache
                fetchPreload: async () => {
                    try {
                        const response = await fetch(RESTAURANT_CONFIG.logo, {
                            method: 'GET',
                            cache: 'force-cache',
                            priority: 'high'
                        });
                        if (response.ok) {
                            const blob = await response.blob();
                            const objectURL = URL.createObjectURL(blob);
                            sessionStorage.setItem('logo-blob-url', objectURL);
                            console.log('✅ Logo cached via Fetch API');
                        }
                    } catch (error) {
                        console.warn('⚠️ Fetch preload failed:', error);
                    }
                },

                // Strategy 3: Link preload in DOM
                linkPreload: () => {
                    const existingPreload = document.querySelector(`link[href="${RESTAURANT_CONFIG.logo}"]`);
                    if (!existingPreload) {
                        const link = document.createElement('link');
                        link.rel = 'preload';
                        link.as = 'image';
                        link.href = RESTAURANT_CONFIG.logo;
                        link.fetchpriority = 'high';
                        document.head.appendChild(link);
                        console.log('✅ Logo preload link added');
                    }
                }
            };

            // Execute all preload strategies
            preloadStrategies.imagePreload();
            preloadStrategies.fetchPreload();
            preloadStrategies.linkPreload();

            // ✅ ENHANCED: Optimized logo application with IntersectionObserver
            const logoObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        applyLogoToElement(img);
                        logoObserver.unobserve(img);
                    }
                });
            }, { rootMargin: '50px' });

            function applyLogoToElement(img) {
                if (!img || img.dataset.logoApplied === 'true') return;

                // Use cached blob URL if available
                const blobUrl = sessionStorage.getItem('logo-blob-url');
                img.src = blobUrl || RESTAURANT_CONFIG.logo;
                img.style.color = 'transparent';
                img.dataset.logoApplied = 'true';

                // Add loaded class after image loads
                img.onload = () => {
                    img.classList.add('loaded');
                    console.log('✅ Logo loaded:', img.id);
                };

                img.onerror = () => {
                    console.error('❌ Logo failed to load:', img.id);
                    img.classList.add('loaded'); // Show anyway to prevent indefinite loading
                };
            }

            function applyLogo() {
                const logoIds = ['langing-kiosk-logo', 'kiosk-logo'];
                let appliedCount = 0;

                logoIds.forEach(id => {
                    const img = document.getElementById(id);
                    if (img) {
                        // Use IntersectionObserver for lazy loading
                        if ('IntersectionObserver' in window) {
                            logoObserver.observe(img);
                        } else {
                            // Fallback for older browsers
                            applyLogoToElement(img);
                        }
                        appliedCount++;
                    }
                });

                return appliedCount > 0;
            }

            // ✅ ENHANCED: Immediate application with MutationObserver fallback
            function initLogoApplication() {
                const targetIds = new Set(['langing-kiosk-logo', 'kiosk-logo']);
                const appliedIds = new Set();

                // Try immediate application
                applyLogo();

                // Setup MutationObserver for dynamically added elements
                const observer = new MutationObserver((mutations) => {
                    let foundNew = false;
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (node.nodeType === 1) {
                                if (targetIds.has(node.id) && !appliedIds.has(node.id)) {
                                    if ('IntersectionObserver' in window) {
                                        logoObserver.observe(node);
                                    } else {
                                        applyLogoToElement(node);
                                    }
                                    appliedIds.add(node.id);
                                    foundNew = true;
                                }
                                // Check descendants
                                targetIds.forEach(id => {
                                    const img = node.querySelector?.(`#${id}`);
                                    if (img && !appliedIds.has(id)) {
                                        if ('IntersectionObserver' in window) {
                                            logoObserver.observe(img);
                                        } else {
                                            applyLogoToElement(img);
                                        }
                                        appliedIds.add(id);
                                        foundNew = true;
                                    }
                                });
                            }
                        });
                    });

                    // Disconnect observer once all logos are found
                    if (appliedIds.size === targetIds.size) {
                        observer.disconnect();
                        console.log('✅ All logos found, observer disconnected');
                    }
                });

                // Start observing
                if (document.body) {
                    observer.observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                } else {
                    // Body not ready, wait for DOMContentLoaded
                    document.addEventListener('DOMContentLoaded', () => {
                        observer.observe(document.body, {
                            childList: true,
                            subtree: true
                        });
                    });
                }
            }

            // ✅ ENHANCED: Execute based on document state
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLogoApplication);
            } else {
                initLogoApplication();
            }

            function adjustColor(hex, percent) {
                const num = parseInt(hex.replace('#', ''), 16);
                const amt = Math.round(2.55 * percent);
                const R = Math.min(255, Math.max(0, (num >> 16) + amt));
                const G = Math.min(255, Math.max(0, (num >> 8 & 0x00FF) + amt));
                const B = Math.min(255, Math.max(0, (num & 0x0000FF) + amt));
                return `#${(0x1000000 + (R << 16) + (G << 8) + B).toString(16).slice(1)}`;
            }

            window.RESTAURANT_CONFIG = RESTAURANT_CONFIG;
            window.applyLogoToElement = applyLogoToElement; // Export for external use
        })();
    </script>

