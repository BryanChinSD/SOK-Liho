                function showToast(message, type = 'info', title = '', duration = 4000) {
                    const toast = document.getElementById('notificationToast');
                    if (!toast) {
                        console.error('Toast element not found');
                        return;
                    }

                    // Set title and message
                    const titleEl = toast.querySelector('.toast-title');
                    const messageEl = toast.querySelector('.toast-message');

                    if (titleEl) {
                        if (title) {
                            titleEl.textContent = title;
                            titleEl.style.display = 'block';
                        } else {
                            titleEl.style.display = 'none';
                        }
                    }

                    if (messageEl) {
                        messageEl.textContent = message;
                    }

                    // Set type class
                    toast.className = `notification-toast ${type} show`;

                    // Auto-hide after duration
                    setTimeout(() => {
                        closeNotificationToast();
                    }, duration);

                    console.log(`📢 Toast shown: ${type} - ${message}`);
                }

                /**
                 * Close toast notification
                 */
                function closeNotificationToast() {
                    const toast = document.getElementById('notificationToast');
                    if (!toast) return;

                    toast.classList.add('hiding');

                    setTimeout(() => {
                        toast.classList.remove('show', 'hiding');
                        toast.style.display = 'none';
                    }, 300);
                }


                function showConfirm(message, title = 'Confirm Action', options = {}) {
                    console.log('🔥 showConfirm CALLED', { message, title });
                    return new Promise((resolve) => {
                        const modal = document.getElementById('confirmModal');
                        if (!modal) {
                            console.error('Confirm modal not found');
                            resolve(false);
                            return;
                        }

                        const titleEl = document.getElementById('confirmModalTitle');
                        const messageEl = document.getElementById('confirmModalMessage');
                        const confirmBtn = document.getElementById('confirmOkBtn');
                        const cancelBtn = document.getElementById('confirmCancelBtn');

                        // Set content
                        if (titleEl) titleEl.textContent = title;
                        if (messageEl) messageEl.textContent = message;

                        // Set button text
                        if (confirmBtn) {
                            confirmBtn.textContent = options.confirmText || 'Confirm';
                            confirmBtn.className = `confirm-modal-btn confirm-btn ${options.danger ? 'danger' : ''}`;
                        }
                        if (cancelBtn) {
                            cancelBtn.textContent = options.cancelText || 'Cancel';
                        }

                        // ✅ Clone buttons to strip ALL previously stacked listeners
                        const freshConfirmBtn = confirmBtn.cloneNode(true);
                        const freshCancelBtn = cancelBtn.cloneNode(true);
                        confirmBtn.replaceWith(freshConfirmBtn);
                        cancelBtn.replaceWith(freshCancelBtn);

                        // Show modal
                        modal.style.display = 'flex';
                        setTimeout(() => modal.classList.add('active'), 10);
                        document.body.style.overflow = 'hidden';

                        // Handle confirm
                        const handleConfirm = () => {
                            closeConfirmModal();
                            resolve(true);
                            cleanup();
                        };

                        // Handle cancel
                        const handleCancel = () => {
                            closeConfirmModal();
                            resolve(false);
                            cleanup();
                        };

                        // Cleanup function
                        const cleanup = () => {
                            freshConfirmBtn.removeEventListener('click', handleConfirm);
                            freshCancelBtn.removeEventListener('click', handleCancel);
                            document.removeEventListener('keydown', handleEscape);
                        };

                        // Handle escape key
                        const handleEscape = (e) => {
                            if (e.key === 'Escape') {
                                handleCancel();
                            }
                        };

                        // Attach event listeners to the FRESH (clone) buttons
                        freshConfirmBtn.addEventListener('click', handleConfirm);
                        freshCancelBtn.addEventListener('click', handleCancel);
                        document.addEventListener('keydown', handleEscape);

                        console.log(`❓ Confirm dialog shown: ${title}`);
                    });
                }

                function closeConfirmModal() {
                    const modal = document.getElementById('confirmModal');
                    if (!modal) return;

                    modal.classList.remove('active');

                    setTimeout(() => {
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                    }, 300);
                }

                function showAlert(message, title = 'Notification', type = 'info') {
                    return new Promise((resolve) => {
                        const modal = document.getElementById('alertModal');
                        if (!modal) {
                            console.error('Alert modal not found');
                            resolve();
                            return;
                        }

                        const titleEl = document.getElementById('alertModalTitle');
                        const messageEl = document.getElementById('alertModalMessage');
                        const iconEl = document.getElementById('alertModalIcon');
                        const okBtn = document.getElementById('alertOkBtn');

                        // Set content
                        if (titleEl) titleEl.textContent = title;
                        if (messageEl) messageEl.textContent = message;

                        // Set icon based on type
                        if (iconEl) {
                            iconEl.className = `alert-modal-icon ${type}`;
                            iconEl.innerHTML = getAlertIcon(type);
                        }

                        // Show modal
                        modal.style.display = 'flex';
                        setTimeout(() => modal.classList.add('active'), 10);
                        document.body.style.overflow = 'hidden';

                        // Handle OK
                        const handleOk = () => {
                            closeAlertModal();
                            resolve();
                            cleanup();
                        };

                        // Cleanup function
                        const cleanup = () => {
                            okBtn?.removeEventListener('click', handleOk);
                            document.removeEventListener('keydown', handleEnter);
                        };

                        // Handle enter key
                        const handleEnter = (e) => {
                            if (e.key === 'Enter') {
                                handleOk();
                            }
                        };

                        // Attach event listeners
                        okBtn?.addEventListener('click', handleOk);
                        document.addEventListener('keydown', handleEnter);

                        console.log(`ℹ️ Alert shown: ${title}`);
                    });
                }

                /**
                 * Close alert modal
                 */
                function closeAlertModal() {
                    const modal = document.getElementById('alertModal');
                    if (!modal) return;

                    modal.classList.remove('active');

                    setTimeout(() => {
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                    }, 300);
                }

                function getAlertIcon(type) {
                    const icons = {
                        success: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>',
                        error: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>',
                        warning: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>',
                        info: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>'
                    };

                    return icons[type] || icons.info;
                }


                function showVoucherRemovalConfirm(voucherName) {
                    return new Promise((resolve) => {
                        const modal = document.getElementById('voucherRemovalModal');
