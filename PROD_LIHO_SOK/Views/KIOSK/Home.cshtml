    <script>
                window.modalState = {
                                cartOpen: false,
                                addonOpen: false,
                                successOpen: false,
                                editingMode: false,

                                isAnyOpen() {
                                    return this.cartOpen || this.addonOpen || this.successOpen;
                                },

                                updateState(newState) {
                                    Object.assign(this, newState);
                                    console.log('📊 Modal state:', {
                                        cart: this.cartOpen,
                                        addon: this.addonOpen,
                                        success: this.successOpen,
                                        editing: this.editingMode
                                    });
                                    this.scheduleBottomNavUpdate();
                                },

                                scheduleBottomNavUpdate() {
                                    clearTimeout(this._visibilityTimeout);
                                    this._visibilityTimeout = setTimeout(() => {
                                        if (typeof updateBottomNavVisibility === 'function') {
                                            updateBottomNavVisibility();
                                        }
                                    }, 50);
                                }
                            };

                            // ============================================
                            // UTILITY FUNCTIONS
                            // ============================================

                            function updateLandingTime() {
                                const now = new Date();
                                const timeString = now.toLocaleTimeString('en-US', {
                                    hour: 'numeric',
                                    minute: '2-digit',
                                    hour12: true
                                });
                                const landingTimeEl = document.getElementById('landingTime');
                                if (landingTimeEl) {
                                    landingTimeEl.textContent = timeString;
                                }
                            }

                            function updateTime() {
                                const now = new Date();
                                const currentTimeEl = document.getElementById('currentTime');
                                if (currentTimeEl) {
                                    currentTimeEl.textContent = now.toLocaleTimeString();
                                }
                            }

                            // ============================================
                            // MODAL MANAGEMENT FUNCTIONS (FIXED)
                            // ============================================

        function openCartModal() {
            const overlay = document.getElementById('cartModalOverlay');
            const modal = document.getElementById('cartModal');
            const bottomNav = document.querySelector('.bottom-nav');

            if (!overlay || !modal) return;

            // Update state FIRST
            window.modalState.updateState({ cartOpen: true });

            // ✅ Hide bottom nav with class
            if (bottomNav) {
                bottomNav.classList.add('modal-open');
            }

            // Then update DOM
            document.body.classList.add('modal-open');
            overlay.style.display = 'block';
            modal.style.display = 'block';

            // Force reflow
            void overlay.offsetHeight;

            overlay.classList.add('active');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';

            console.log('🛒 Cart modal opened');
        }

        function closeCartModal() {
            const overlay = document.getElementById('cartModalOverlay');
            const modal = document.getElementById('cartModal');
            const bottomNav = document.querySelector('.bottom-nav');

            if (!overlay || !modal) return;

            // Update state FIRST
            window.modalState.updateState({
                cartOpen: false,
                editingMode: false
            });

            // ✅ Show bottom nav with class removal
            if (bottomNav) {
                bottomNav.classList.remove('modal-open');
            }

            // Update bottom nav visibility
            updateBottomNavVisibility();

            // Then update DOM
            overlay.classList.remove('active');
            modal.classList.remove('active');

            // Wait for animation
            setTimeout(() => {
                overlay.style.display = 'none';
                modal.style.display = 'none';

                // Only restore scroll if no modals open
                if (!window.modalState.isAnyOpen()) {
                    document.body.style.overflow = 'auto';
                    document.body.classList.remove('modal-open');
                }
            }, 300);

            window.currentEditingSno = null;
            console.log('🛒 Cart modal closed');
        }
                            (function enableCartSwipeToClose() {
                                const modal = document.getElementById('cartModal');
                                if (!modal) return;

                                let startX = 0;
                                let startY = 0;
                                let isSwiping = false;

                                modal.addEventListener('touchstart', e => {
                                    if (e.touches.length !== 1) return;
                                    startX = e.touches[0].clientX;
                                    startY = e.touches[0].clientY;
                                    isSwiping = false;
                                });

                                modal.addEventListener('touchmove', e => {
                                    if (e.touches.length !== 1) return;

                                    const deltaX = e.touches[0].clientX - startX;
                                    const deltaY = e.touches[0].clientY - startY;

                                    // Only trigger if swipe is mostly horizontal and to the right
                                    if (Math.abs(deltaY) < 30 && deltaX > 80) {
                                        isSwiping = true;
                                    }
                                });

                                modal.addEventListener('touchend', () => {
                                    if (isSwiping) {
                                        console.log('👉 Swipe right detected, closing cart modal');
                                        closeCartModal();
                                    }
                                });
                             })();


                            function toggleCart() {
                                if (window.modalState.cartOpen) {
                                    closeCartModal();
                                } else {
                                    openCartModal();
                                }
                            }


                        function openAddonModal() {
                            const modal = document.getElementById('addonModal');
                            const bottomNav = document.querySelector('.bottom-nav');
                            if (!modal) return;

                            // Track if editing existing item
                            const isEditingExistingItem = window.currentEditingSno != null || window.modalState.cartOpen;

                            // Close cart modal if it's open
                            if (window.modalState.cartOpen) {
                                const overlay = document.getElementById('cartModalOverlay');
                                const cartModal = document.getElementById('cartModal');

                                if (overlay && cartModal) {
                                    overlay.classList.remove('active');
                                    cartModal.classList.remove('active');
                                    overlay.style.display = 'none';
                                    cartModal.style.display = 'none';
                                }
                            }

                            // Update modal state
                            window.modalState.updateState({
                                addonOpen: true,
                                cartOpen: false,
                                editingMode: isEditingExistingItem
                            });

                            // Show addon modal
                            modal.classList.add('show');
                            modal.classList.remove('close');

                            // Hide bottom nav via class
                            if (bottomNav) bottomNav.classList.remove('show');

                            // Prevent page scroll
                            document.body.style.overflow = 'hidden';

                            console.log('➕ Addon modal opened', isEditingExistingItem ? '(edit mode)' : '(new item)');
                        }



                               function closeAddonModal() {
                            const modal = document.getElementById('addonModal');
                            const bottomNav = document.querySelector('.bottom-nav');
                            if (!modal) return;

                            const wasEditing = window.modalState.editingMode;
                            const TRANSITION_MS = 300; // Match CSS transition

                            // Hide addon modal
                            modal.classList.remove('show');
                            modal.classList.add('close');

                            // Update modal state immediately
                            window.modalState.updateState({ addonOpen: false });

                            // After animation completes
                            setTimeout(() => {
                                document.body.style.overflow = '';

                                if (wasEditing) {
                                    console.log('🔄 Edit mode: returning to cart');

                                    window.modalState.updateState({
                                        editingMode: false,
                                        cartOpen: false
                                    });

                                    if (typeof openCartModal === 'function') {
                                        openCartModal(); // cart modal handles bottom-nav itself
                                    }
                                } else {
                                    console.log('✅ New item mode: closing addon');

                                    window.modalState.updateState({
                                        editingMode: false,
                                        cartOpen: false,
                                        successOpen: false
                                    });

                                    // Show bottom nav smoothly via class
                                    if (bottomNav) bottomNav.classList.add('show');
                                }

                                console.log('✅ Addon modal closed');
                            }, TRANSITION_MS);
                        }


                            function openSuccessModal(salesNumber) {
                                const modal = document.getElementById('successModal');
                                const orderNumberEl = document.getElementById('orderNumber');

                                if (!modal) return;

                                window.modalState.updateState({ successOpen: true });

                                if (orderNumberEl) {
                                    // Use API sales number or generate from timestamp
                                    orderNumberEl.textContent = salesNumber || `#${Date.now().toString().slice(-6)}`;
                                }

                                modal.style.display = 'flex';
                                document.body.style.overflow = 'hidden';

                                console.log('🎉 Success modal opened');
                            }

                            function closeSuccessModal() {
                                const modal = document.getElementById('successModal');
                                if (!modal) return;

                                window.modalState.updateState({ successOpen: false });

                                modal.style.display = 'none';

                                if (!window.modalState.isAnyOpen()) {
                                    document.body.style.overflow = 'auto';
                                    document.body.classList.remove('modal-open');
                                }

                                if (typeof currentAddonParentItem !== 'undefined') {
                                    currentAddonParentItem = null;
                                }

                                console.log('🎉 Success modal closed');
                            }


                                    function updateBottomNavVisibility() {
                                        const bottomNav = document.querySelector('.bottom-nav');
                                        if (!bottomNav) {
                                            console.warn('⚠️ Bottom nav element not found');
                                            return;
                                        }

                                        // Get current modal state
                                        const isModalOpen = window.modalState.isAnyOpen();

                                        console.log('🔍 Bottom nav check:', {
                                            cartOpen: window.modalState.cartOpen,
                                            addonOpen: window.modalState.addonOpen,
                                            successOpen: window.modalState.successOpen,
                                            anyModalOpen: isModalOpen
                                        });

                                        // Rule 1: ALWAYS hide if ANY modal is open
                                        if (isModalOpen) {
                                            bottomNav.style.display = 'none';
                                            bottomNav.classList.remove('show');
                                            console.log('🚫 Bottom nav hidden - modal open');
                                            return;
                                        }

                                        // Rule 2: Check if cart has items (prioritize useOrder system)
                                        const hasCartItems = (() => {
                                            // Primary: Check useOrder system
                                            if (typeof useOrder === 'function') {
                                                const orderObj = useOrder();
                                                const items = orderObj?.order?.sales_dtls || [];

                                                // Check for actual items (not empty array)
                                                const hasValidItems = items.some(item =>
                                                    item && item.item_no && item.qty > 0
                                                );

                                                console.log('📦 useOrder check:', {
                                                    totalItems: items.length,
                                                    hasValidItems: hasValidItems
                                                });

                                                if (hasValidItems) return true;
                                            }

                                            // Fallback: Check DOM for empty cart message
                                            const cartItemsEl = document.getElementById('cartItems');
                                            const domCheck = cartItemsEl && !cartItemsEl.querySelector('.empty-cart');

                                            console.log('🔍 DOM check:', { hasItems: domCheck });

                                            return domCheck;
                                        })();

                                        // Rule 3: Show only if has items and no modals are open
                                        if (hasCartItems) {
                                            bottomNav.style.display = 'flex';
                                            bottomNav.classList.add('show');
                                            console.log('✅ Bottom nav shown - has items');
                                        } else {
                                            bottomNav.style.display = 'none';
                                            bottomNav.classList.remove('show');
                                            console.log('🚫 Bottom nav hidden - empty cart');
                                        }
                                    }


                                    // ============================================
                                    // ENHANCED CART MONITORING
                                    // ============================================

                                    function setupEnhancedCartMonitoring() {
                                        // Track last known cart count
                                        window._lastOrderItemCount = 0;

                                        // Intercept renderCartFromOrder
                                        if (typeof renderCartFromOrder === 'function') {
                                            const originalRenderCart = window.renderCartFromOrder;
                                            window.renderCartFromOrder = function(...args) {
                                                console.log('🔄 renderCartFromOrder called');
                                                const result = originalRenderCart.apply(this, args);

                                                // Wait longer to ensure cart is fully rendered
                                                setTimeout(() => {
                                                    console.log('🔄 Updating bottom nav after renderCart');
                                                    updateBottomNavVisibility();
                                                }, 300);

                                                return result;
                                            };
                                        }

                                        // Intercept addToCart
                                        if (typeof addToCart === 'function') {
                                            const originalAddToCart = window.addToCart;
                                            window.addToCart = function(...args) {
                                                console.log('🛒 addToCart called');
                                                const result = originalAddToCart.apply(this, args);

                                                setTimeout(() => {
                                                    console.log('🔄 Updating bottom nav after addToCart');
                                                    updateBottomNavVisibility();
                                                }, 400);

                                                return result;
                                            };
                                        }

                                        // Monitor order changes - ONLY when no modals are open
                                        const checkOrderUpdates = setInterval(() => {
                                            // Skip if any modal is open
                                            if (window.modalState.isAnyOpen()) {
                                                return;
                                            }

                                            if (typeof useOrder === 'function') {
                                                const orderObj = useOrder();
                                                const items = orderObj?.order?.sales_dtls || [];
                                                const currentItemCount = items.filter(item =>
                                                    item && item.item_no && item.qty > 0
                                                ).length;

                                                if (window._lastOrderItemCount !== currentItemCount) {
                                                    console.log('🔄 Order count changed:', window._lastOrderItemCount, '→', currentItemCount);
                                                    window._lastOrderItemCount = currentItemCount;

                                                    // Only update if no modals are open
                                                    if (!window.modalState.isAnyOpen()) {
                                                        updateBottomNavVisibility();
                                                    }
                                                }
                                            }
                                        }, 500);

                                        window._orderCheckInterval = checkOrderUpdates;
                                    }

                            // ============================================
                            // EVENT HANDLERS & INITIALIZATION
                            // ============================================

                            function setupEventListeners() {
                                // ESC key handler
                                document.addEventListener('keydown', (event) => {
                                    if (event.key === 'Escape') {
                                        if (window.modalState.successOpen) closeSuccessModal();
                                        else if (window.modalState.addonOpen) closeAddonModal();
                                        else if (window.modalState.cartOpen) closeCartModal();
                                    }
                                });

                                // Click outside handlers
                                document.getElementById('addonModal')?.addEventListener('click', (e) => {
                                    if (e.target === e.currentTarget) closeAddonModal();
                                });

                                document.getElementById('successModal')?.addEventListener('click', (e) => {
                                    if (e.target === e.currentTarget) closeSuccessModal();
                                });

                                document.getElementById('cartModalOverlay')?.addEventListener('click', (e) => {
                                    if (e.target === e.currentTarget) closeCartModal();
                                });
                            }

                            function initializeApp() {
                                console.log('🚀 Initializing kiosk application...');

                                // Initialize time displays
                                updateLandingTime();
                                setInterval(updateLandingTime, 1000);

                                if (typeof updateTime === 'function') {
                                    updateTime();
                                    setInterval(updateTime, 1000);
                                }

                                // Initialize language
                                const savedLang = localStorage.getItem("selectedLang") || 'en';
                                if (typeof selectLanguage === 'function') {
                                    selectLanguage(savedLang);
                                }

                                // Setup event listeners
                                setupEventListeners();

                                // Enhanced cart monitoring
                                setupEnhancedCartMonitoring();

                                // Initialize bottom nav
                                const bottomNav = document.querySelector('.bottom-nav');
                                if (bottomNav) {
                                    bottomNav.style.display = 'none'; // Start hidden

                                    // Check initial state after load
                                    setTimeout(() => {
                                        console.log('🔧 Initial bottom nav check');
                                        updateBottomNavVisibility();
                                    }, 500);
                                } else {
                                    console.error('❌ Bottom nav element not found');
                                }

                                console.log('✅ App initialization complete');
                            }

                            // ============================================
                            // GLOBAL EXPORTS
                            // ============================================

                            window.toggleCart = toggleCart;
                            window.openCartModal = openCartModal;
                            window.closeCartModal = closeCartModal;
                            window.openAddonModal = openAddonModal;
                            window.closeAddonModal = closeAddonModal;
                            window.openSuccessModal = openSuccessModal;
                            window.closeSuccessModal = closeSuccessModal;
                            window.updateBottomNavVisibility = updateBottomNavVisibility;

                            // Backward compatibility
                            window.closeCart = closeCartModal;
                            window.closeModal = closeSuccessModal;

                            // ============================================
                            // APPLICATION START
                            // ============================================

                            document.addEventListener("DOMContentLoaded", initializeApp);


                            // Cancel empty cart
                            document.getElementById('cancelEmptyCart').addEventListener('click', function () {
                                console.log('Empty cart cancelled by user');
                                const modal = document.getElementById('emptyCartModalOverlay');
                                modal.classList.remove('active');
                            });


                            function toggleAutoScroll() {
                            const toggle = document.getElementById('autoScrollToggle');
                            const playIcon = toggle.querySelector('.icon-play');
                            const pauseIcon = toggle.querySelector('.icon-pause');

                            if (window.mobileCategoryTabs.isAutoScrollEnabled()) {
                                // Stop auto-scroll
                                window.mobileCategoryTabs.stopAutoScroll();
                                toggle.classList.remove('active');
                                playIcon.style.display = 'block';
                                pauseIcon.style.display = 'none';

                                // Remove progress class
                                document.querySelectorAll('.category-tab').forEach(tab => {
                                    tab.classList.remove('auto-scrolling');
                                });
                            } else {
                                // Start auto-scroll
                                window.mobileCategoryTabs.startAutoScroll();
                                toggle.classList.add('active');
                                playIcon.style.display = 'none';
                                pauseIcon.style.display = 'block';

                                // Add progress class to active tab
                                const activeTab = document.querySelector('.category-tab.active');
                                if (activeTab) {
                                    activeTab.classList.add('auto-scrolling');
                                }
                            }
                        }

                        // ============================================
                        // SHOW CONTROL ON MOBILE
                        // ============================================
                        function initAutoScrollControl() {
                            if (window.innerWidth <= 992) {
                                const control = document.getElementById('autoScrollControl');
                                if (control) {
                                    control.style.display = 'block';

                                    // Set initial state
                                    setTimeout(() => {
                                        const toggle = document.getElementById('autoScrollToggle');
                                        if (toggle && window.mobileCategoryTabs.isAutoScrollEnabled()) {
                                            toggle.classList.add('active');
                                            toggle.querySelector('.icon-play').style.display = 'none';
                                            toggle.querySelector('.icon-pause').style.display = 'block';
                                        }
                                    }, 3500);
                                }
                            }
                        }

                        // Initialize on load
                        document.addEventListener('DOMContentLoaded', initAutoScrollControl);

                        // Update active tab progress indicator
                        document.addEventListener('click', function(e) {
                            if (e.target.closest('.category-tab')) {
                                document.querySelectorAll('.category-tab').forEach(tab => {
                                    tab.classList.remove('auto-scrolling');
                                });

                                if (window.mobileCategoryTabs.isAutoScrollEnabled()) {
                                    setTimeout(() => {
                                        const activeTab = document.querySelector('.category-tab.active');
                                        if (activeTab) {
                                            activeTab.classList.add('auto-scrolling');
                                        }
                                    }, 100);
                                }
                            }
                        });

                        // ============================================
                        // AUTO-SWITCH CATEGORY TABS ON SCROLL
                        // ============================================

                        function initScrollToSwitchCategory() {
                            const menuSection = document.querySelector('.menu-section');
                            const categoryTabs = document.querySelectorAll('.category-tab');

                            if (!menuSection || categoryTabs.length === 0) {
                                console.warn('⚠️ Menu section or category tabs not found');
                                return;
                            }

                            let isScrolling;
                            let currentActiveCategory = null;
                            let isUserScrolling = false;

                            console.log('🔄 Initializing scroll-to-switch category detection');

                            // Debounced scroll handler
                            menuSection.addEventListener('scroll', function() {
                                isUserScrolling = true;
                                window.clearTimeout(isScrolling);

                                isScrolling = setTimeout(function() {
                                    detectVisibleCategory();
                                    isUserScrolling = false;
                                }, 150);
                            });

                            function detectVisibleCategory() {
                                const menuSectionRect = menuSection.getBoundingClientRect();
                                const viewportTop = menuSectionRect.top + 80; // Offset for header

                                // Get all visible category sections
                                const categorySections = document.querySelectorAll('[data-category-section]');

                                if (categorySections.length === 0) {
                                    console.warn('⚠️ No category sections found - make sure renderCategoryByCode adds data-category-section');
                                    return;
                                }

                                let visibleCategory = null;
                                let maxVisibleArea = 0;

                                // Find category with most visible area
                                categorySections.forEach(section => {
                                    const sectionRect = section.getBoundingClientRect();

                                    // Calculate visible area
                                    const visibleTop = Math.max(sectionRect.top, menuSectionRect.top);
                                    const visibleBottom = Math.min(sectionRect.bottom, menuSectionRect.bottom);
                                    const visibleArea = Math.max(0, visibleBottom - visibleTop);

                                    if (visibleArea > maxVisibleArea) {
                                        maxVisibleArea = visibleArea;
                                        visibleCategory = section.dataset.categorySection;
                                    }
                                });

                                // Switch active tab if category changed
                                if (visibleCategory && visibleCategory !== currentActiveCategory) {
                                    currentActiveCategory = visibleCategory;
                                    switchActiveTab(visibleCategory);
                                }
                            }

                            function switchActiveTab(categoryCode) {
                                // Don't switch if user is manually clicking tabs
                                if (document.querySelector('.category-tab:active')) {
                                    return;
                                }

                                // Remove active from all tabs
                                categoryTabs.forEach(tab => {
                                    tab.classList.remove('active');
                                });

                                // Find and activate matching tab
                                const targetTab = document.querySelector(`.category-tab[data-category="${categoryCode}"]`);

                                if (targetTab) {
                                    targetTab.classList.add('active');

                                    // Scroll tab into view on mobile
                                    if (window.innerWidth <= 992) {
                                        const sidebar = document.querySelector('.navigation-sidebar');
                                        if (sidebar) {
                                            const tabLeft = targetTab.offsetLeft;
                                            const tabWidth = targetTab.offsetWidth;
                                            const sidebarWidth = sidebar.offsetWidth;

                                            sidebar.scrollTo({
                                                left: tabLeft - (sidebarWidth / 2) + (tabWidth / 2),
                                                behavior: 'smooth'
                                            });
                                        }
                                    }

                                    console.log('📍 Auto-switched to category:', categoryCode);
                                }
                            }

                            // Trigger initial detection
                            setTimeout(() => {
                                detectVisibleCategory();
                            }, 500);

                            console.log('✅ Scroll-to-switch-category initialized');
                        }

                        // ============================================
                        // PAUSE AUTO-SCROLL WHEN USER SCROLLS MENU
                        // ============================================

                        function pauseAutoScrollOnMenuScroll() {
                            if (window.innerWidth > 992) return;

                            const menuSection = document.querySelector('.menu-section');

                            if (!menuSection) return;

                            const interactionEvents = ['touchstart', 'mousedown', 'wheel', 'scroll'];

                            interactionEvents.forEach(event => {
                                menuSection.addEventListener(event, () => {
                                    // Pause auto-scroll carousel when user scrolls menu
                                    if (typeof window.mobileCategoryTabs !== 'undefined' &&
                                        typeof window.mobileCategoryTabs.pauseAutoScroll === 'function') {
                                        window.mobileCategoryTabs.pauseAutoScroll();
                                    }
                                }, { passive: true });
                            });

                            console.log('✅ Menu scroll detection initialized');
                        }

                        // ============================================
                        // SMOOTH SCROLL TO CATEGORY
                        // ============================================

                        function scrollToCategorySection(categoryCode) {
                            const categorySection = document.querySelector(`[data-category-section="${categoryCode}"]`);
                            const menuSection = document.querySelector('.menu-section');

                            if (!categorySection || !menuSection) return;

                            const menuSectionRect = menuSection.getBoundingClientRect();
                            const sectionRect = categorySection.getBoundingClientRect();

                            // Calculate scroll position (account for header)
                            const scrollTop = menuSection.scrollTop + sectionRect.top - menuSectionRect.top - 20;

                            menuSection.scrollTo({
                                top: scrollTop,
                                behavior: 'smooth'
                            });
                        }

                        // ============================================
                        // ENHANCE CATEGORY TAB CLICKS
                        // ============================================

                        function enhanceCategoryTabClicks() {
                            const categoryTabs = document.querySelectorAll('.category-tab');

                            categoryTabs.forEach(tab => {
                                // Store original click handler
                                const originalOnClick = tab.onclick;

                                tab.addEventListener('click', function(e) {
                                    const categoryCode = this.dataset.category;

                                    // Execute original handler if exists
                                    if (originalOnClick) {
                                        originalOnClick.call(this, e);
                                    }

                                    // Smooth scroll to category section
                                    setTimeout(() => {
                                        scrollToCategorySection(categoryCode);
                                    }, 100);
                                });
                            });
                        }

                        // ============================================
                        // INITIALIZE ON DOM READY
                        // ============================================

                        (function initScrollFeatures() {
                            console.log('🚀 Initializing enhanced scroll features...');

                            // Wait for GetHomeAPI.js to load and render categories
                            const initTimer = setInterval(() => {
                                const menuSection = document.querySelector('.menu-section');
                                const categoryTabs = document.querySelectorAll('.category-tab');

                                if (menuSection && categoryTabs.length > 0) {
                                    clearInterval(initTimer);

                                    console.log('✅ Menu elements found, initializing scroll detection');

                                    // Initialize all features
                                    initScrollToSwitchCategory();
