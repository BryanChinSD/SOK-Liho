                (function() {
                    'use strict';

                    let lastScroll = 0;

                    function ultraFixCart() {
                        const cartItems = document.getElementById('cartItems');
                        if (!cartItems) return;

                        // Save scroll
                        lastScroll = cartItems.scrollTop;

                        // Apply styles (your existing code)
                        const cartModal = document.getElementById('cartModal');
                        if (cartModal) {
                            cartModal.style.setProperty('display', 'flex', 'important');
                            cartModal.style.setProperty('flex-direction', 'column', 'important');
                            cartModal.style.setProperty('overflow', 'hidden', 'important');
                        }

                        const cartContent = cartModal?.querySelector('.cart-content');
                        if (cartContent) {
                            cartContent.style.setProperty('flex', '1 1 auto', 'important');
                            cartContent.style.setProperty('min-height', '0', 'important');
                            cartContent.style.setProperty('display', 'flex', 'important');
                            cartContent.style.setProperty('flex-direction', 'column', 'important');
                            cartContent.style.setProperty('overflow', 'hidden', 'important');
                        }

                        cartItems.style.setProperty('flex', '1 1 auto', 'important');
                        cartItems.style.setProperty('min-height', '0', 'important');
                        cartItems.style.setProperty('overflow-y', 'auto', 'important');
                        cartItems.style.setProperty('overflow-x', 'hidden', 'important');
                        cartItems.style.setProperty('display', 'flex', 'important');
                        cartItems.style.setProperty('flex-direction', 'column', 'important');
                        cartItems.style.setProperty('gap', '12px', 'important');
                        cartItems.style.setProperty('padding', '20px', 'important');
                        cartItems.style.setProperty('grid-template-columns', 'none', 'important');

                        const cards = document.querySelectorAll('#cartItems .cart-item-card');
                        cards.forEach((card) => {
                            card.style.setProperty('margin', '0', 'important');
                            card.style.setProperty('isolation', 'isolate', 'important');
                            card.style.setProperty('position', 'relative', 'important');
                        });

                        const summary = cartModal?.querySelector('.cart-summary');
                        if (summary) {
                            summary.style.setProperty('flex', '0 0 auto', 'important');
                            summary.style.setProperty('flex-shrink', '0', 'important');
                        }

                        // Restore scroll
                        if (lastScroll > 0) {
                            cartItems.scrollTop = lastScroll;
                        }
                    }

                    ultraFixCart();
                    let interval = setInterval(ultraFixCart, 500); // Run every 500ms

                    window.ultraFixCart = ultraFixCart;
                })();

                document.querySelector('.close-btn').addEventListener('click', function (e) {
                  const btn = this;
                  const circle = document.createElement('span');
                  const diameter = Math.max(btn.clientWidth, btn.clientHeight);
                  const radius = diameter / 2;
                  const rect = btn.getBoundingClientRect();

                  circle.classList.add('ripple');
                  circle.style.width  = circle.style.height = `${diameter}px`;
                  circle.style.left   = `${e.clientX - rect.left - radius}px`;
                  circle.style.top    = `${e.clientY - rect.top  - radius}px`;

                  btn.querySelector('.ripple')?.remove();
                  btn.appendChild(circle);
                });

                function numpadPress(key) {
                    const el = document.getElementById('phoneNumber');
                    if (el.value.length < 8) el.value += key;
                }

                function numpadDelete() {
                    const el = document.getElementById('phoneNumber');
                    el.value = el.value.slice(0, -1);
                }

                function numpadClear() {
                    document.getElementById('phoneNumber').value = '';
                }
