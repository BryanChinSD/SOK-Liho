                                // ============================================
                                // AUTO-LOAD NEXT CATEGORY ON SCROLL TO BOTTOM (INFINITE SCROLL)
                                // ============================================

                                function initInfiniteScrollCategories() {
                                    const menuSection = document.querySelector('.menu-section');
                                    const categoryTabs = document.querySelectorAll('.category-tab');

                                    if (!menuSection || categoryTabs.length === 0) {
                                        console.warn('⚠️ Menu section or category tabs not found for infinite scroll');
                                        return;
                                    }

                                    let isLoadingNextCategory = false;
                                    let allCategories = Array.from(categoryTabs).map(tab => tab.dataset.category);
                                    let loadedCategories = new Set(); // Track which categories are already loaded

                                    console.log('🔄 Initializing infinite scroll for categories');
                                    console.log('📋 Available categories:', allCategories);

                                    // Detect scroll to bottom
                                    menuSection.addEventListener('scroll', function() {
                                        // Don't trigger if already loading
                                        if (isLoadingNextCategory) return;

                                        const scrollTop = menuSection.scrollTop;
                                        const scrollHeight = menuSection.scrollHeight;
                                        const clientHeight = menuSection.clientHeight;

                                        // Calculate distance from bottom (100px threshold for early trigger)
                                        const distanceFromBottom = scrollHeight - (scrollTop + clientHeight);

                                        // When user is near bottom (within 100px)
                                        if (distanceFromBottom < 100) {
                                            loadNextCategory();
                                        }
                                    });

                                    async function loadNextCategory() {
                                        // Get currently visible category
                                        const menuGrid = document.getElementById('menuGrid');
                                        if (!menuGrid) return;

                                        const categorySections = menuGrid.querySelectorAll('[data-category-section]');
                                        if (categorySections.length === 0) return;

                                        // Get the last loaded category
                                        const lastSection = categorySections[categorySections.length - 1];
                                        const lastCategoryCode = lastSection.dataset.categorySection;

                                        // Find index of last category
                                        const lastIndex = allCategories.indexOf(lastCategoryCode);
                                        const nextIndex = lastIndex + 1;

                                        if (nextIndex >= allCategories.length) {
                                            console.log('✅ All categories loaded');
                                            return;
                                        }

                                        const nextCategoryCode = allCategories[nextIndex];

                                        // Check if already loaded
                                        if (loadedCategories.has(nextCategoryCode)) {
                                            console.log(`⚠️ Category ${nextCategoryCode} already loaded`);
                                            return;
                                        }

                                        console.log(`📦 Loading next category: ${nextCategoryCode} (${nextIndex + 1}/${allCategories.length})`);

                                        isLoadingNextCategory = true;
                                        loadedCategories.add(nextCategoryCode);

                                        // Show loading indicator
                                        const loadingDiv = document.createElement('div');
                                        loadingDiv.id = 'category-loading';
                                        loadingDiv.className = 'category-loading-indicator';
                                        loadingDiv.innerHTML = `
                                            <div class="loading-spinner"></div>
                                            <p class="loading-text">Loading more items...</p>
                                        `;
                                        menuGrid.appendChild(loadingDiv);

                                        try {
                                            // Call your existing function to append category
                                            await appendCategoryToGrid(nextCategoryCode);

                                            console.log(`✅ Loaded category: ${nextCategoryCode}`);

                                        } catch (error) {
                                            console.error('❌ Error loading next category:', error);
                                            loadedCategories.delete(nextCategoryCode); // Remove from loaded set on error
                                        } finally {
                                            // Remove loading indicator
                                            const loadingIndicator = document.getElementById('category-loading');
                                            if (loadingIndicator) {
                                                loadingIndicator.remove();
                                            }

                                            isLoadingNextCategory = false;
                                        }
                                    }

                                    console.log('✅ Infinite scroll initialized');
                                }

                                // ============================================
                                // APPEND CATEGORY TO GRID (DON'T REPLACE)
                                // ============================================

                                async function appendCategoryToGrid(categoryCode) {
                                    const container = document.getElementById('menuGrid');
                                    if (!container) return;

                                    // Check if category already exists
                                    if (container.querySelector(`[data-category-section="${categoryCode}"]`)) {
                                        console.log(`⚠️ Category ${categoryCode} already in DOM`);
                                        return;
                                    }

                                    // Get selected language
                                    const selectedLang = localStorage.getItem("selectedLang") || 'en';

                                    try {
                                        // Access cache
                                        if (typeof useCache !== 'function') {
                                            console.error('❌ useCache not available');
                                            return;
                                        }

                                        const { items } = useCache();

                                        if (!Array.isArray(items) || !items.length) {
                                            console.error('❌ No items in cache');
                                            return;
                                        }

                                        // Create category section wrapper
                                        const categorySection = document.createElement('div');
                                        categorySection.className = 'category-section';
                                        categorySection.dataset.categorySection = categoryCode;

                                        // Get translated category name
                                        let categoryName = categoryCode;
                                        if (typeof getTranslatedName === 'function') {
                                            try {
                                                categoryName = await getTranslatedName(categoryCode, categoryCode, selectedLang, "category");
                                            } catch (error) {
                                                console.warn('Translation failed:', error);
                                            }
                                        }

                                        // Add sticky category title
                                        const categoryTitle = document.createElement('h2');
                                        categoryTitle.className = 'category-section-title';
                                        categoryTitle.textContent = categoryName;
                                        categorySection.appendChild(categoryTitle);

                                        // Filter items for this category
                                        const seen = new Set();
                                        const code = categoryCode.trim().toLowerCase();

                                        const filteredItems = items.filter(item => {
                                            if (!item || !item.item_no || seen.has(item.item_no)) return false;
                                            const itemCat = String(item.category_code || "").trim().toLowerCase();
                                            if (!itemCat || itemCat === "null" || itemCat !== code) return false;
                                            seen.add(item.item_no);
                                            return true;
                                        });

                                        if (filteredItems.length === 0) {
                                            console.log(`⚠️ No items in category ${categoryCode}`);
                                            return;
                                        }

                                        // Translate items
                                        let translatedItems = filteredItems;
                                        if (typeof getTranslatedName === 'function') {
                                            const translatedResults = await Promise.allSettled(
                                                filteredItems.map(async item => {
                                                    try {
                                                        const display_name = await getTranslatedName(item.item_no, item.item_name, selectedLang, "item");
                                                        return { ...item, display_name };
                                                    } catch (error) {
                                                        return { ...item, display_name: item.item_name || item.item_no };
                                                    }
                                                })
                                            );

                                            translatedItems = translatedResults
                                                .filter(result => result.status === 'fulfilled')
                                                .map(result => result.value);
                                        }

                                        // Create items grid container
                                        const itemsGrid = document.createElement('div');
                                        itemsGrid.className = 'menu-grid';

                                        // Render items using your existing helper functions
                                        itemsGrid.innerHTML = translatedItems.map((item, index) => {
                                            const id = item.item_no;
                                            const hasMenuTypeGrpDtls = Array.isArray(item.itemmaster_menutype_grpdtls)
                                                ? item.itemmaster_menutype_grpdtls.length > 0
                                                : Boolean(item.itemmaster_menutype_grpdtls);

                                            // Get price
                                            let priceValue = 0;
                                            if (typeof getPriceByServiceType === 'function') {
                                                const priceObj = item?.selling_uom_dtls?.[0]?.price_dtls?.[0] || item;
                                                priceValue = hasMenuTypeGrpDtls ? null : parseFloat(getPriceByServiceType(priceObj));
                                            }
                                            const displayPrice = !isNaN(priceValue) && priceValue > 0 ? `$${priceValue.toFixed(2)}` : '';

                                            // Get image URL
                                            let imageUrl = '';
                                            if (typeof resolveImageUrl === 'function') {
                                                imageUrl = resolveImageUrl(item, null);
                                            } else {
                                                imageUrl = item.tqr_image_url || item.item_image || '';
                                                if (imageUrl && !imageUrl.startsWith('http')) {
                                                    const baseUrl = window.RESTAURANT_CONFIG?.baseImageUrl || '/API/GetImageProxy?imageUrl=';
                                                    imageUrl = baseUrl + imageUrl;
                                                }
                                            }

                                            const restaurantLogo = window.RESTAURANT_CONFIG?.logo || '';

                                            return `
                                                <div class="menu-item p-4 border rounded shadow" data-item-name="${item.item_name}">
                                                    <div class="item-image">
                                                        <div class="image-wrapper" style="position: relative; width: 100%; height: 100%; background: #f0f0f0; border-radius: var(--radius-md); overflow: hidden;">
                                                            <img src="${imageUrl}"
                                                                alt="${item.display_name}"
                                                                loading="lazy"
                                                                decoding="async"
                                                                style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-md); display: block;"
                                                                onerror="this.onerror=null; if(this.src!=='${restaurantLogo}') this.src='${restaurantLogo}';">
                                                        </div>
                                                    </div>
                                                    <div class="item-info">
                                                        <h3 class="font-semibold">${item.display_name}</h3>
                                                        <p class="item-description text-sm text-gray-600">${item.item_desc || ''}</p>
                                                        <div class="item-footer flex justify-between items-center mt-2">
                                                            <span class="item-price font-bold ${hasMenuTypeGrpDtls ? 'invisible' : ''}">
                                                                ${displayPrice}
                                                            </span>
                                                            <button class="add-btn bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded w-full max-w-[100px]"
                                                                data-item-id="${id}">
                                                                Add to Cart
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            `;
                                        }).join('');

                                        categorySection.appendChild(itemsGrid);
                                        container.appendChild(categorySection);

                                        // Attach event listeners for "Add to Cart" buttons
                                        const addButtons = itemsGrid.querySelectorAll('.add-btn');
                                        addButtons.forEach(btn => {
                                            btn.addEventListener('click', function(e) {
                                                e.stopPropagation();
                                                const itemId = this.getAttribute('data-item-id');
                                                if (typeof addToCart === 'function') {
                                                    addToCart(itemId);
                                                }
                                            });
                                        });

                                        console.log(`✅ Appended ${translatedItems.length} items for category ${categoryCode}`);

                                    } catch (error) {
                                        console.error('❌ Error in appendCategoryToGrid:', error);
                                    }
                                }

