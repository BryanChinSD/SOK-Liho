         let currentLang = 'en';

         function toggleLanguageDropdown() {
             const dropdown = document.getElementById('languageOptions');
             dropdown.classList.toggle('show');
         }

         function generateLanguageCode(languageName) {
             const languageMap = {
                 'English': 'en',
                 'Spanish': 'es',
                 'Español': 'es',
                 'French': 'fr',
                 'Français': 'fr',
                 'German': 'de',
                 'Deutsch': 'de',
                 'Chinese': 'zh',
                 '中文': 'zh',
                 'Japanese': 'ja',
                 '日本語': 'ja',
                 'Arabic': 'ar',
                 'العربية': 'ar',
                 'Tamil': 'ta',
                 'தமிழ்': 'ta',
                 'Hindi': 'hi',
                 'हिन्दी': 'hi',
                 'Portuguese': 'pt',
                 'Português': 'pt',
                 'Russian': 'ru',
                 'Русский': 'ru',
                 'Korean': 'ko',
                 '한국어': 'ko'
             };

             return languageMap[languageName] || languageName.toLowerCase().substring(0, 2);
         }

         function getLanguageFlag(langCode) {
             const flags = {
                 en: '🇺🇸',
                 es: '🇪🇸',
                 fr: '🇫🇷',
                 de: '🇩🇪',
                 zh: '🇨🇳',
                 ja: '🇯🇵',
                 ar: '🇸🇦',
                 ta: '🇱🇰',
                 hi: '🇮🇳',
                 pt: '🇵🇹',
                 ru: '🇷🇺',
                 ko: '🇰🇷'
             };

             return flags[langCode] || '🌐';
         }

         function selectLanguage(langCode) {
             currentLang = langCode;

             const storedLanguages = JSON.parse(localStorage.getItem("serviceLanguages") || "[]");
             const langData = storedLanguages.find(lang =>
                 generateLanguageCode(lang.language_name) === langCode
             );
             const languageName = langData ? langData.language_name : langCode.toUpperCase();
             localStorage.setItem("selectedLang", languageName);

             const flag = getLanguageFlag(langCode);
             const currentFlagEl = document.getElementById('currentFlag');
             const currentLanguageEl = document.getElementById('currentLanguage');

             if (currentFlagEl) currentFlagEl.textContent = flag;
             if (currentLanguageEl) currentLanguageEl.textContent = languageName;

             document.querySelectorAll('.language-option').forEach(option => {
                 option.classList.remove('active');
             });

             const selectedOption = document.querySelector(`[data-lang="${langCode}"]`);
             if (selectedOption) {
                 selectedOption.classList.add('active');
             }

             const languageOptions = document.getElementById('languageOptions');
             if (languageOptions) {
                 languageOptions.classList.remove('show');
             }

             updateLanguage();

             const rtlLanguages = ['ar', 'he', 'fa', 'ur'];
             if (rtlLanguages.includes(langCode)) {
                 document.documentElement.setAttribute('dir', 'rtl');
             } else {
                 document.documentElement.setAttribute('dir', 'ltr');
             }

             localStorage.setItem('currentLanguage', JSON.stringify({
                 code: langCode,
                 name: languageName
             }));
         }

         function loadSavedLanguage() {
             const saved = localStorage.getItem('currentLanguage');
             if (saved) {
                 try {
                     const { code, name } = JSON.parse(saved);
                     selectLanguage(code, name);
                 } catch (err) {
                     console.error("Failed to load saved language:", err);
                 }
             }
         }

         function updateLanguage() {
             const elements = document.querySelectorAll('[data-i18n]');
             elements.forEach(element => {
                 const key = element.getAttribute('data-i18n');
                 if (translations[currentLang] && translations[currentLang][key]) {
                     element.innerHTML = translations[currentLang][key];
                 }
             });
         }

